# ------------------------------------------------------------------
# VoucherSense AI — environment configuration
# Copy this file to `.env` and fill in the real values by hand.
# Never commit a real .env file. Never let an agent generate credentials.
# ------------------------------------------------------------------

# --- Credentials (required, supplied by the human) -------------------
# Set these manually. They are never read from anywhere except config/index.ts.
GEMINI_API_KEY=
DATABASE_URL=

# --- Sessions -------------------------------------------------------------
# Signs the session cookie. Optional in dev (an ephemeral secret is generated
# at startup when unset); set a stable long random value if you want sessions
# to survive restarts.
SESSION_SECRET=
# How long a session cookie stays valid (seconds). Default: 12 hours.
SESSION_MAX_AGE_SECONDS=43200

# --- AI / Gemini ----------------------------------------------------
# Single vision-capable model serving BOTH roles (extractor + analyst).
# This value lives ONLY in config/index.ts via GEMINI_MODEL. Default: gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash
# Enforced timeout for a single AI call (ms).
AI_TIMEOUT_MS=30000
# Maximum output tokens per structured response (raised in PRD v2: realistic
# supermarket receipts need more headroom, bounded by the 40-item cap).
AI_MAX_OUTPUT_TOKENS=2000
# Extraction/transformation only — determinism over variation.
AI_TEMPERATURE=0
# Additional attempts after the first (max total attempts = maxRetries + 1).
AI_MAX_RETRIES=2

# --- Queue / worker --------------------------------------------------
# Global bound on simultaneous in-flight Gemini calls (extraction + analyst).
WORKER_CONCURRENCY=4
# DB-polling interval for the background worker (ms).
WORKER_POLL_INTERVAL_MS=1000
# A job stuck in 'processing' for this long is reclaimed by the reaper (ms).
# 2x the AI timeout so a legitimately slow call is never reclaimed mid-flight.
STALE_JOB_TIMEOUT_MS=60000

# --- Uploads ---------------------------------------------------------
# PRD §8: 8 MB per file.
MAX_UPLOAD_BYTES=8388608
# PRD §7/§10 evidence scenario: up to 50 files per batch request.
MAX_FILES_PER_BATCH=50

# --- Rate limiting (per user, per minute) ----------------------------
# Upload bucket counts REQUESTS, not files — one batch = one unit.
RATE_LIMIT_UPLOAD=10
# Summarise bucket is tracked independently of the upload bucket.
RATE_LIMIT_SUMMARIZE=20

# --- Storage ---------------------------------------------------------
# "local" for local development; "s3" for an S3-compatible object store.
STORAGE_DRIVER=local
# Base directory for local storage. Storage keys already begin with
# "receipts/" so files land at ./storage/receipts/<yyyy>/<mm>/<id>.<ext>.
STORAGE_LOCAL_PATH=./storage
# S3-compatible settings (only used when STORAGE_DRIVER=s3)
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=auto
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=