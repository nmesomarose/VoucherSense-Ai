{
  "name": "vouchersense-ai",
  "version": "0.1.0",
  "private": true,
  "description": "VoucherSense AI — AI-powered receipt processing (AI engineering assessment MVP)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "worker": "node --env-file-if-exists=.env --import tsx worker/index.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@google/genai": "^2.22.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "prisma": "7.10.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
